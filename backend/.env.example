NODE_ENV=development
PORT=3000
MONGO_URI=
GOOGLE_API_KEY=

# Required in every environment. Generate locally with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Never commit the generated value. Placeholder values intentionally fail startup.
JWT_SECRET=<generate-a-long-random-secret>

CLIENT_URL=http://localhost:5173
# CLIENT_URLS takes precedence. Origins only; production requires HTTPS.
# CLIENT_URLS=http://localhost:5173,https://example.com
# Include the public app origin for same-origin reverse-proxy deployments too.
# Unsafe requests require trusted Origin, or trusted Referer when Origin is absent.
# curl/API clients must send Origin explicitly; missing both headers is rejected.

# lax (default), strict, or none. Prefer lax for same-site frontend/API hosting.
# Truly cross-site hosting requires none and HTTPS; browsers may block third-party cookies.
# Production always uses Secure. none enables Secure in development too (use HTTPS).
COOKIE_SAME_SITE=lax

# Rate limits use process memory and assume a single backend instance.
# Multiple instances require a shared store such as Redis in a later phase.
# Production trusts exactly one reverse proxy hop; match this to the host topology.
# Browser CSP belongs on the separately hosted React HTML; the JSON API disables CSP.
# Run `npm run db:indexes:check`, review the diff, then `npm run db:indexes`
# during deployment. syncIndexes can drop indexes absent from Mongoose schemas.
